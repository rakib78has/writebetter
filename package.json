{
  "name": "writebetter",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension that improves selected text: grammar, spelling, clarity and tone.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build && node scripts/generate-notices.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node scripts/build-test-editors.mjs && playwright test",
    "validate:build": "node scripts/validate-build.mjs",
    "package": "node scripts/package.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run validate:build",
    "verify:package": "node scripts/verify-package.mjs",
    "check:version": "node scripts/check-version.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "sbom": "node scripts/generate-sbom.mjs"
  },
  "dependencies": {
    "harper.js": "2.10.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@lexical/history": "0.51.0",
    "@lexical/rich-text": "0.51.0",
    "@lexical/utils": "0.51.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/chrome": "0.3.5",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "lexical": "0.51.0",
    "prettier": "3.9.9",
    "prosemirror-commands": "1.7.2",
    "prosemirror-history": "1.5.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-model": "1.25.12",
    "prosemirror-schema-basic": "1.2.5",
    "prosemirror-state": "1.4.4",
    "prosemirror-view": "1.42.6",
    "quill": "2.0.3",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
